datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. CORE & MULTI-TENANCY
// -------------------------------------------------------------

model Company {
  id              String          @id @default(cuid())
  name            String
  legalName       String?
  gstin           String?
  pan             String?
  cin             String?
  email           String?
  phone           String?
  address         String?
  city            String?
  state           String?
  stateCode       String?
  pincode         String?
  currency        String          @default("INR")
  currencySymbol  String          @default("₹")
  logoUrl         String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  branches        Branch[]
  financialYears  FinancialYear[]
  users           User[]
  roles           Role[]
  accountGroups   AccountGroup[]
  ledgers         Ledger[]
  vouchers        Voucher[]
  productGroups   ProductGroup[]
  products        Product[]
  warehouses      Warehouse[]
  customers       Customer[]
  suppliers       Supplier[]
  salesOrders     SalesOrder[]
  saleInvoices    SaleInvoice[]
  purchaseOrders  PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
  boms            BOM[]
  productionOrders ProductionOrder[]
  batteryModels   BatteryModel[]
  solarProjects   SolarProject[]
  departments     Department[]
  designations    Designation[]
  employees       Employee[]
  payrollRuns     PayrollRun[]
  dealers         Dealer[]
  serviceTickets  ServiceTicket[]
  leads           Lead[]
  auditLogs       AuditLog[]

  @@map("companies")
}

model Branch {
  id              String          @id @default(cuid())
  companyId       String
  name            String
  code            String
  gstin           String?
  state           String
  stateCode       String
  address         String?
  phone           String?
  isHeadOffice    Boolean         @default(false)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouses      Warehouse[]
  users           User[]
  vouchers        Voucher[]
  salesOrders     SalesOrder[]
  saleInvoices    SaleInvoice[]
  purchaseOrders  PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
  productionOrders ProductionOrder[]

  @@map("branches")
}

model FinancialYear {
  id              String          @id @default(cuid())
  companyId       String
  yearCode        String
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean         @default(true)
  isLocked        Boolean         @default(false)
  createdAt       DateTime        @default(now())

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vouchers        Voucher[]

  @@map("financial_years")
}

model User {
  id              String          @id @default(cuid())
  companyId       String
  branchId        String?
  roleId          String
  username        String          @unique
  email           String          @unique
  passwordHash    String
  fullName        String
  phone           String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch          Branch?         @relation(fields: [branchId], references: [id])
  role            Role            @relation(fields: [roleId], references: [id])
  vouchersCreated Voucher[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Role {
  id              String          @id @default(cuid())
  companyId       String
  name            String
  description     String?
  isSystem        Boolean         @default(false)
  createdAt       DateTime        @default(now())

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users           User[]
  permissions     RolePermission[]

  @@map("roles")
}

model RolePermission {
  id              String          @id @default(cuid())
  roleId          String
  module          String
  action          String

  role            Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module, action])
  @@map("role_permissions")
}

model AccountGroup {
  id              String          @id @default(cuid())
  companyId       String
  parentGroupId   String?
  name            String
  code            String
  nature          String
  sequence        Int             @default(0)
  createdAt       DateTime        @default(now())

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentGroup     AccountGroup?   @relation("GroupHierarchy", fields: [parentGroupId], references: [id])
  childGroups     AccountGroup[]  @relation("GroupHierarchy")
  ledgers         Ledger[]

  @@map("account_groups")
}

model Ledger {
  id              String          @id @default(cuid())
  companyId       String
  accountGroupId  String
  name            String
  code            String
  openingBalance  Decimal         @default(0.0) @db.Decimal(15, 2)
  openingType     String          @default("DEBIT")
  currentBalance  Decimal         @default(0.0) @db.Decimal(15, 2)
  balanceType     String          @default("DEBIT")
  gstin           String?
  pan             String?
  hsnSacCode      String?
  stateCode       String?
  isBankCash      Boolean         @default(false)
  isPartyLedger   Boolean         @default(false)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountGroup    AccountGroup    @relation(fields: [accountGroupId], references: [id])
  voucherEntries  VoucherEntry[]
  customer        Customer?
  supplier        Supplier?
  bankAccount     BankAccount?

  @@map("ledgers")
}

model Voucher {
  id              String          @id @default(cuid())
  companyId       String
  branchId        String
  financialYearId String
  voucherNumber   String
  voucherType     String
  date            DateTime
  narration       String?
  totalAmount     Decimal         @default(0.0) @db.Decimal(15, 2)
  referenceType   String?
  referenceId     String?
  status          String          @default("POSTED")
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch          Branch          @relation(fields: [branchId], references: [id])
  financialYear   FinancialYear   @relation(fields: [financialYearId], references: [id])
  createdBy       User            @relation(fields: [createdById], references: [id])
  entries         VoucherEntry[]

  @@unique([companyId, voucherType, voucherNumber])
  @@map("vouchers")
}

model VoucherEntry {
  id              String          @id @default(cuid())
  voucherId       String
  ledgerId        String
  type            String
  amount          Decimal         @db.Decimal(15, 2)
  narration       String?

  voucher         Voucher         @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  ledger          Ledger          @relation(fields: [ledgerId], references: [id])

  @@map("voucher_entries")
}

model ProductGroup {
  id              String          @id @default(cuid())
  companyId       String
  name            String
  code            String
  description     String?

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products        Product[]

  @@map("product_groups")
}

model Product {
  id              String          @id @default(cuid())
  companyId       String
  productGroupId  String
  sku             String
  name            String
  description     String?
  unit            String          @default("NOS")
  hsnSacCode      String?
  gstRate         Decimal         @default(18.0) @db.Decimal(5, 2)
  purchasePrice   Decimal         @default(0.0) @db.Decimal(15, 2)
  sellingPrice    Decimal         @default(0.0) @db.Decimal(15, 2)
  minStockAlert   Decimal         @default(5.0) @db.Decimal(12, 2)
  currentStock    Decimal         @default(0.0) @db.Decimal(12, 2)
  isSerialized    Boolean         @default(false)
  productType     String          @default("STANDARD")
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productGroup    ProductGroup    @relation(fields: [productGroupId], references: [id])
  stockTransactions StockTransaction[]
  serialNumbers   SerialNumber[]
  saleItems       SaleItem[]
  purchaseItems   PurchaseItem[]
  bomOutputs      BOM[]           @relation("BOMOutput")
  bomItems        BOMItem[]
  batteryModel    BatteryModel?

  @@map("products")
}

model Warehouse {
  id              String          @id @default(cuid())
  companyId       String
  branchId        String
  name            String
  code            String
  address         String?
  isPrimary       Boolean         @default(false)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch          Branch          @relation(fields: [branchId], references: [id])
  stockTransactions StockTransaction[]
  serialNumbers   SerialNumber[]

  @@map("warehouses")
}

model StockTransaction {
  id              String          @id @default(cuid())
  companyId       String
  warehouseId     String
  productId       String
  transactionType String
  quantity        Decimal         @db.Decimal(12, 2)
  unitCost        Decimal         @default(0.0) @db.Decimal(15, 2)
  totalCost       Decimal         @default(0.0) @db.Decimal(15, 2)
  referenceType   String?
  referenceId     String?
  batchNumber     String?
  serialNumber    String?
  createdAt       DateTime        @default(now())

  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  product         Product         @relation(fields: [productId], references: [id])

  @@map("stock_transactions")
}

model SerialNumber {
  id              String          @id @default(cuid())
  productId       String
  warehouseId     String?
  serialNumber    String          @unique
  batchNumber     String?
  status          String          @default("IN_STOCK")
  manufacturingDate DateTime?
  dispatchDate    DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  product         Product         @relation(fields: [productId], references: [id])
  warehouse       Warehouse?      @relation(fields: [warehouseId], references: [id])

  @@map("serial_numbers")
}

model Customer {
  id              String          @id @default(cuid())
  companyId       String
  ledgerId        String          @unique
  tradeName       String
  legalName       String?
  gstin           String?
  pan             String?
  phone           String?
  email           String?
  billingAddress  String?
  shippingAddress String?
  state           String
  stateCode       String
  creditLimit     Decimal         @default(0.0) @db.Decimal(15, 2)
  creditDays      Int             @default(30)
  outstanding     Decimal         @default(0.0) @db.Decimal(15, 2)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ledger          Ledger          @relation(fields: [ledgerId], references: [id])
  salesOrders     SalesOrder[]
  saleInvoices    SaleInvoice[]
  batteryWarranties BatteryWarranty[]
  solarProjects   SolarProject[]

  @@map("customers")
}

model SalesOrder {
  id              String          @id @default(cuid())
  companyId       String
  branchId        String
  orderNumber     String
  orderDate       DateTime
  customerId      String
  subTotal        Decimal         @default(0.0) @db.Decimal(15, 2)
  taxTotal        Decimal         @default(0.0) @db.Decimal(15, 2)
  grandTotal      Decimal         @default(0.0) @db.Decimal(15, 2)
  status          String          @default("PENDING")
  createdAt       DateTime        @default(now())

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch          Branch          @relation(fields: [branchId], references: [id])
  customer        Customer        @relation(fields: [customerId], references: [id])
  saleInvoices    SaleInvoice[]

  @@map("sales_orders")
}

model SaleInvoice {
  id              String          @id @default(cuid())
  companyId       String
  branchId        String
  invoiceNumber   String
  invoiceDate     DateTime
  dueDate         DateTime?
  customerId      String
  salesOrderId    String?
  voucherId       String?
  placeOfSupply   String
  isInterState    Boolean         @default(false)
  subTotal        Decimal         @default(0.0) @db.Decimal(15, 2)
  cgstTotal       Decimal         @default(0.0) @db.Decimal(15, 2)
  sgstTotal       Decimal         @default(0.0) @db.Decimal(15, 2)
  igstTotal       Decimal         @default(0.0) @db.Decimal(15, 2)
  cessTotal       Decimal         @default(0.0) @db.Decimal(15, 2)
  roundOff        Decimal         @default(0.0) @db.Decimal(15, 2)
  grandTotal      Decimal         @default(0.0) @db.Decimal(15, 2)
  paidAmount      Decimal         @default(0.0) @db.Decimal(15, 2)
  paymentStatus   String          @default("UNPAID")
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch          Branch          @relation(fields: [branchId], references: [id])
  customer        Customer        @relation(fields: [customerId], references: [id])
  salesOrder      SalesOrder?     @relation(fields: [salesOrderId], references: [id])
  items           SaleItem[]
  eInvoice        EInvoice?
  ewayBill        EwayBill?

  @@map("sale_invoices")
}

model SaleItem {
  id              String          @id @default(cuid())
  saleInvoiceId   String
  productId       String
  quantity        Decimal         @db.Decimal(12, 2)
  unitPrice       Decimal         @db.Decimal(15, 2)
  discountPercent Decimal         @default(0.0) @db.Decimal(5, 2)
  discountAmount  Decimal         @default(0.0) @db.Decimal(15, 2)
  taxableAmount   Decimal         @db.Decimal(15, 2)
  gstRate         Decimal         @db.Decimal(5, 2)
  cgstAmount      Decimal         @default(0.0) @db.Decimal(15, 2)
  sgstAmount      Decimal         @default(0.0) @db.Decimal(15, 2)
  igstAmount      Decimal         @default(0.0) @db.Decimal(15, 2)
  totalAmount     Decimal         @db.Decimal(15, 2)

  saleInvoice     SaleInvoice     @relation(fields: [saleInvoiceId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

model EInvoice {
  id              String          @id @default(cuid())
  saleInvoiceId   String          @unique
  irn             String          @unique
  ackNo           String?
  ackDate         DateTime?
  signedInvoice   String?
  signedQrCode    String?
  status          String          @default("GENERATED")
  createdAt       DateTime        @default(now())

  saleInvoice     SaleInvoice     @relation(fields: [saleInvoiceId], references: [id], onDelete: Cascade)

  @@map("e_invoices")
}

model EwayBill {
  id              String          @id @default(cuid())
  saleInvoiceId   String          @unique
  ewbNumber       String          @unique
  ewbDate         DateTime
  validUpto       DateTime
  vehicleNumber   String?
  transporterId   String?
  status          String          @default("ACTIVE")
  createdAt       DateTime        @default(now())

  saleInvoice     SaleInvoice     @relation(fields: [saleInvoiceId], references: [id], onDelete: Cascade)

  @@map("eway_bills")
}

model Supplier {
  id              String          @id @default(cuid())
  companyId       String
  ledgerId        String          @unique
  tradeName       String
  legalName       String?
  gstin           String?
  pan             String?
  phone           String?
  email           String?
  address         String?
  state           String
  stateCode       String
  creditDays      Int             @default(30)
  outstanding     Decimal         @default(0.0) @db.Decimal(15, 2)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ledger          Ledger          @relation(fields: [ledgerId], references: [id])
  purchaseOrders  PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]

  @@map("suppliers")
}

model PurchaseOrder {
  id              String          @id @default(cuid())
  companyId       String
  branchId        String
  poNumber        String
  poDate          DateTime
  supplierId      String
  grandTotal      Decimal         @default(0.0) @db.Decimal(15, 2)
  status          String          @default("PENDING")
  createdAt       DateTime        @default(now())

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch          Branch          @relation(fields: [branchId], references: [id])
  supplier        Supplier        @relation(fields: [supplierId], references: [id])
  purchaseInvoices PurchaseInvoice[]

  @@map("purchase_orders")
}

model PurchaseInvoice {
  id              String          @id @default(cuid())
  companyId       String
  branchId        String
  billNumber      String
  billDate        DateTime
  supplierId      String
  purchaseOrderId String?
  voucherId       String?
  isInterState    Boolean         @default(false)
  subTotal        Decimal         @default(0.0) @db.Decimal(15, 2)
  cgstTotal       Decimal         @default(0.0) @db.Decimal(15, 2)
  sgstTotal       Decimal         @default(0.0) @db.Decimal(15, 2)
  igstTotal       Decimal         @default(0.0) @db.Decimal(15, 2)
  grandTotal      Decimal         @default(0.0) @db.Decimal(15, 2)
  paidAmount      Decimal         @default(0.0) @db.Decimal(15, 2)
  paymentStatus   String          @default("UNPAID")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch          Branch          @relation(fields: [branchId], references: [id])
  supplier        Supplier        @relation(fields: [supplierId], references: [id])
  purchaseOrder   PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])
  items           PurchaseItem[]

  @@map("purchase_invoices")
}

model PurchaseItem {
  id              String          @id @default(cuid())
  purchaseInvoiceId String
  productId       String
  quantity        Decimal         @db.Decimal(12, 2)
  unitPrice       Decimal         @db.Decimal(15, 2)
  taxableAmount   Decimal         @db.Decimal(15, 2)
  gstRate         Decimal         @db.Decimal(5, 2)
  taxAmount       Decimal         @db.Decimal(15, 2)
  totalAmount     Decimal         @db.Decimal(15, 2)

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])

  @@map("purchase_items")
}

model BankAccount {
  id              String          @id @default(cuid())
  ledgerId        String          @unique
  bankName        String
  accountNumber   String
  ifscCode        String
  branchName      String?
  accountType     String          @default("CURRENT")

  ledger          Ledger          @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@map("bank_accounts")
}

model Department {
  id              String          @id @default(cuid())
  companyId       String
  name            String
  code            String

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees       Employee[]

  @@map("departments")
}

model Designation {
  id              String          @id @default(cuid())
  companyId       String
  title           String
  code            String

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees       Employee[]

  @@map("designations")
}

model Employee {
  id              String          @id @default(cuid())
  companyId       String
  departmentId    String
  designationId   String
  employeeCode    String          @unique
  firstName       String
  lastName        String
  email           String?
  phone           String?
  panNumber       String?
  aadhaarNumber   String?
  bankAccountNo   String?
  ifscCode        String?
  dateOfJoining   DateTime
  monthlySalary   Decimal         @default(0.0) @db.Decimal(15, 2)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department      Department      @relation(fields: [departmentId], references: [id])
  designation     Designation     @relation(fields: [designationId], references: [id])
  salaryStructure SalaryStructure?
  attendances     Attendance[]
  payslips        Payslip[]

  @@map("employees")
}

model SalaryStructure {
  id              String          @id @default(cuid())
  employeeId      String          @unique
  basicSalary     Decimal         @db.Decimal(15, 2)
  hra             Decimal         @default(0.0) @db.Decimal(15, 2)
  conveyance      Decimal         @default(0.0) @db.Decimal(15, 2)
  specialAllowance Decimal        @default(0.0) @db.Decimal(15, 2)
  pfDeduction     Decimal         @default(0.0) @db.Decimal(15, 2)
  esiDeduction    Decimal         @default(0.0) @db.Decimal(15, 2)
  professionalTax Decimal         @default(0.0) @db.Decimal(15, 2)

  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("salary_structures")
}

model Attendance {
  id              String          @id @default(cuid())
  employeeId      String
  date            DateTime
  status          String          @default("PRESENT")
  hoursWorked     Decimal         @default(8.0) @db.Decimal(4, 2)

  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@map("attendances")
}

model PayrollRun {
  id              String          @id @default(cuid())
  companyId       String
  month           Int
  year            Int
  totalGross      Decimal         @default(0.0) @db.Decimal(15, 2)
  totalDeductions Decimal         @default(0.0) @db.Decimal(15, 2)
  totalNet        Decimal         @default(0.0) @db.Decimal(15, 2)
  status          String          @default("COMPLETED")
  voucherId       String?
  createdAt       DateTime        @default(now())

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payslips        Payslip[]

  @@unique([companyId, month, year])
  @@map("payroll_runs")
}

model Payslip {
  id              String          @id @default(cuid())
  payrollRunId    String
  employeeId      String
  basicSalary     Decimal         @db.Decimal(15, 2)
  hra             Decimal         @db.Decimal(15, 2)
  allowances      Decimal         @db.Decimal(15, 2)
  grossSalary     Decimal         @db.Decimal(15, 2)
  pfDeduction     Decimal         @db.Decimal(15, 2)
  esiDeduction    Decimal         @db.Decimal(15, 2)
  taxDeductions   Decimal         @db.Decimal(15, 2)
  netSalary       Decimal         @db.Decimal(15, 2)

  payrollRun      PayrollRun      @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee        Employee        @relation(fields: [employeeId], references: [id])

  @@map("payslips")
}

model BOM {
  id              String          @id @default(cuid())
  companyId       String
  productId       String
  code            String
  name            String
  outputQuantity  Decimal         @default(1.0) @db.Decimal(12, 2)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product         Product         @relation("BOMOutput", fields: [productId], references: [id])
  items           BOMItem[]
  productionOrders ProductionOrder[]

  @@map("boms")
}

model BOMItem {
  id              String          @id @default(cuid())
  bomId           String
  productId       String
  quantity        Decimal         @db.Decimal(12, 2)
  scrapAllowance  Decimal         @default(0.0) @db.Decimal(5, 2)

  bom             BOM             @relation(fields: [bomId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])

  @@map("bom_items")
}

model ProductionOrder {
  id              String          @id @default(cuid())
  companyId       String
  branchId        String
  bomId           String
  orderNumber     String
  plannedQuantity Decimal         @db.Decimal(12, 2)
  producedQuantity Decimal        @default(0.0) @db.Decimal(12, 2)
  status          String          @default("PLANNED")
  startDate       DateTime?
  completionDate  DateTime?
  createdAt       DateTime        @default(now())

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch          Branch          @relation(fields: [branchId], references: [id])
  bom             BOM             @relation(fields: [bomId], references: [id])

  @@map("production_orders")
}

model BatteryModel {
  id              String          @id @default(cuid())
  companyId       String
  productId       String          @unique
  batteryType     String
  capacityAh      Decimal         @db.Decimal(8, 2)
  voltage         Decimal         @db.Decimal(6, 2)
  warrantyMonths  Int             @default(36)
  freeReplacementMonths Int       @default(24)
  proRataMonths   Int             @default(12)
  createdAt       DateTime        @default(now())

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  batterySerials  BatterySerial[]

  @@map("battery_models")
}

model BatterySerial {
  id              String          @id @default(cuid())
  batteryModelId  String
  serialNumber    String          @unique
  cellBatchNumber String?
  mfgDate         DateTime        @default(now())
  qcStatus        String          @default("PASSED")
  currentStatus   String          @default("IN_FACTORY")
  createdAt       DateTime        @default(now())

  batteryModel    BatteryModel    @relation(fields: [batteryModelId], references: [id])
  tests           BatteryTest[]
  warranty        BatteryWarranty?

  @@map("battery_serials")
}

model BatteryTest {
  id              String          @id @default(cuid())
  batterySerialId String
  testDate        DateTime        @default(now())
  openCircuitVoltage Decimal      @db.Decimal(6, 2)
  internalResistance Decimal      @db.Decimal(8, 2)
  actualCapacityAh   Decimal      @db.Decimal(8, 2)
  specificGravity    Decimal?     @db.Decimal(6, 3)
  qcResult        String          @default("PASS")
  inspectorName   String?

  batterySerial   BatterySerial   @relation(fields: [batterySerialId], references: [id], onDelete: Cascade)

  @@map("battery_tests")
}

model BatteryWarranty {
  id              String          @id @default(cuid())
  batterySerialId String          @unique
  customerId      String
  invoiceNumber   String?
  purchaseDate    DateTime
  warrantyEndDate DateTime
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())

  batterySerial   BatterySerial   @relation(fields: [batterySerialId], references: [id], onDelete: Cascade)
  customer        Customer        @relation(fields: [customerId], references: [id])
  claims          WarrantyClaim[]

  @@map("battery_warranties")
}

model WarrantyClaim {
  id              String          @id @default(cuid())
  warrantyId      String
  claimNumber     String          @unique
  claimDate       DateTime        @default(now())
  claimType       String
  reportedIssue   String
  testFindings    String?
  approvalStatus  String          @default("PENDING")
  replacementSerial String?
  resolvedDate    DateTime?
  createdAt       DateTime        @default(now())

  warranty        BatteryWarranty @relation(fields: [warrantyId], references: [id], onDelete: Cascade)

  @@map("warranty_claims")
}

model SolarProject {
  id              String          @id @default(cuid())
  companyId       String
  customerId      String
  projectCode     String          @unique
  projectType     String
  capacityKw      Decimal         @db.Decimal(8, 2)
  inverterCapacityKw Decimal?     @db.Decimal(8, 2)
  totalContractValue Decimal      @default(0.0) @db.Decimal(15, 2)
  status          String          @default("LEAD")
  subsidyStatus   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Customer        @relation(fields: [customerId], references: [id])
  surveys         SolarSurvey[]
  amcContracts    SolarAMC[]

  @@map("solar_projects")
}

model SolarSurvey {
  id              String          @id @default(cuid())
  solarProjectId  String
  surveyDate      DateTime        @default(now())
  surveyorName    String?
  roofType        String?
  roofAreaSqFt    Decimal?        @db.Decimal(10, 2)
  shadowFreeSqFt  Decimal?        @db.Decimal(10, 2)
  sanctionedLoadKw Decimal?       @db.Decimal(8, 2)
  proposedCapacityKw Decimal?     @db.Decimal(8, 2)
  notes           String?

  solarProject    SolarProject    @relation(fields: [solarProjectId], references: [id], onDelete: Cascade)

  @@map("solar_surveys")
}

model SolarAMC {
  id              String          @id @default(cuid())
  solarProjectId  String
  contractNumber  String          @unique
  startDate       DateTime
  endDate         DateTime
  annualVisits    Int             @default(4)
  completedVisits Int             @default(0)
  annualAmount    Decimal         @default(0.0) @db.Decimal(15, 2)
  status          String          @default("ACTIVE")

  solarProject    SolarProject    @relation(fields: [solarProjectId], references: [id], onDelete: Cascade)

  @@map("solar_amcs")
}

model Lead {
  id              String          @id @default(cuid())
  companyId       String
  name            String
  companyName     String?
  phone           String
  email           String?
  category        String
  expectedValue   Decimal         @default(0.0) @db.Decimal(15, 2)
  status          String          @default("NEW")
  assignedTo      String?
  createdAt       DateTime        @default(now())

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("leads")
}

model Dealer {
  id              String          @id @default(cuid())
  companyId       String
  dealerCode      String          @unique
  businessName    String
  ownerName       String
  phone           String
  email           String?
  commissionPercent Decimal       @default(5.0) @db.Decimal(5, 2)
  totalSales      Decimal         @default(0.0) @db.Decimal(15, 2)
  totalCommission Decimal         @default(0.0) @db.Decimal(15, 2)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("dealers")
}

model ServiceTicket {
  id              String          @id @default(cuid())
  companyId       String
  ticketNumber    String          @unique
  customerName    String
  customerPhone   String
  productType     String
  serialNumber    String?
  issueReported   String
  resolutionNotes String?
  assignedTechnician String?
  priority        String          @default("MEDIUM")
  status          String          @default("OPEN")
  createdAt       DateTime        @default(now())
  resolvedAt      DateTime?

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("service_tickets")
}

model AuditLog {
  id              String          @id @default(cuid())
  companyId       String
  userId          String?
  entityName      String
  entityId        String
  action          String
  changes         String?
  ipAddress       String?
  createdAt       DateTime        @default(now())

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user            User?           @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
